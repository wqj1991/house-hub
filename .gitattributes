# Windows 上开发、Linux 上部署：仓库里一律 LF，换行符不许进 Git 对象。
* text=auto eol=lf

# 这些文件被 Linux 直接执行或解析，CRLF 会当场炸（bash: \r: command not found）
*.sh      text eol=lf
*.bash    text eol=lf
*.service text eol=lf
*.timer   text eol=lf
*.conf    text eol=lf
*.py      text eol=lf
*.rs      text eol=lf

# 二进制：不做换行符转换，也不做 diff
*.png  binary
*.jpg  binary
*.jpeg binary
*.ico  binary
*.icns binary
*.xlsx binary
*.docx binary
*.pdf  binary
