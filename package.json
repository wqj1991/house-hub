{
  "name": "house-hub",
  "private": true,
  "version": "0.3.4",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @house/web dev",
    "web:dev": "bash scripts/web-dev.sh",
    "build": "pnpm --filter @house/web build",
    "app:dev": "pnpm --filter @house/shell dev",
    "app:build": "pnpm --filter @house/shell build",
    "api:dev": "pnpm --filter @house/api dev",
    "api:start": "pnpm --filter @house/api start",
    "pair": "bash scripts/pair-code.sh",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "worker:once": "python services/worker/worker.py --once",
    "version:sync": "node scripts/version.mjs",
    "version:check": "node scripts/version.mjs --check",
    "check:schema": "node scripts/schema-check.mjs",
    "deploy": "bash infra/deploy.sh",
    "deploy:panel": "node infra/deploy-1panel.mjs",
    "deploy:local": "bash infra/deploy-local.sh"
  }
}
