[Unit]
Description=house worker (job runner)
After=house-api.service
Wants=house-api.service

[Service]
Type=oneshot
User=house
Group=house
WorkingDirectory=/opt/house/current
EnvironmentFile=/opt/house/worker.env
ExecStart=/usr/bin/python3 /opt/house/current/services/worker/worker.py --once
TimeoutStartSec=300
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/house
StandardOutput=journal
StandardError=journal
SyslogIdentifier=house-worker
